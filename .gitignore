# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv/
__pycache__/
.env
data/raw/
data/processed/
data/warehouse/
*.duckdb
.ollama/
chroma_db/

# Scraper cache (rebuildable, not source)
cache_credits/
cache_credits_cork/
cache_credits_tudublin/

# Third-party standards content — GRI's copyrighted documents and the
# requirement text extracted from them. Not ours to redistribute; all of it is
# regenerable with: python standards/fetch_gri.py
# The short disclosure TITLES stay committed in standards/gri_disclosures.json —
# those are identifiers you would cite anyway.
standards/gri/*.pdf
standards/gri/*.txt
standards/gri/pages/
standards/gri_requirements.json

# Downloaded embedding model (~23 MB binary). Re-fetched automatically by
# rag/build_index.py. rag/index/ IS committed — it is small and rebuildable
# but useful to have present.
rag/models/

# Documents linked from STARS answers — the universities' own PDFs and
# spreadsheets, ~440 MB. Not ours to redistribute and fully rebuildable:
#   python -m scrapers.fetch_documents --with-aashe
# documents/manifest.csv IS committed: it records what exists, where it came
# from and which links are dead, which is the part worth keeping in history.
documents/cache/
documents/text/

# The RAG index now embeds the document text above, so committing it would
# smuggle in what the two lines above deliberately exclude — and it is 18 MB.
# Rebuild:  python rag/chunk_corpus.py && python rag/build_index.py
rag/chunks.jsonl
rag/index/

# Windows artifacts
*.zip
*:Zone.Identifier
